# Variabili d'ambiente per l'avvio locale con Docker Compose.
# Copia questo file in .env e inserisci i valori reali (.env e' escluso da git).

# Credenziali SMTP per l'invio email (es. indirizzo Gmail + app password).
MAIL_USERNAME=
MAIL_PASSWORD=

# Password del database Postgres locale (usata sia dal servizio db che dal backend).
# Se vuota, docker-compose usa il default "admin".
DB_PASSWORD=
