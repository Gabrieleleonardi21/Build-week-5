# Copiare in .env (ignorato da git) e compilare. Letto da docker compose.
# Senza valori l'app parte lo stesso: falliscono solo email, upload e AI.

# Password del Postgres del compose (default: admin)
DB_PASSWORD=

# SMTP Gmail: MAIL_PASSWORD e' una "password per le app" di Google
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Cartella su Cloudinary (facoltativa): senza questa riga si usa eventi-dev (prove).
# Su Render e' "eventi". Non lasciarla vuota: una variabile vuota vale "" e non il default.
# CLOUDINARY_FOLDER=eventi-dev

# OpenRouter (miglioramento descrizione evento con AI)
OPENROUTER_API_KEY=
# Facoltativo: senza questa riga si usano modelli gratuiti con immagini (vedi application.yml).
# Piu' modelli separati da virgola = catena di riserva. Non lasciarla vuota.
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free

# Primo SUPERADMIN: email di un utente gia' registrato. All'avvio, se nel DB non c'e'
# ancora nessun SUPERADMIN, viene promosso lui. Poi la variabile non conta piu'.
SUPERADMIN_EMAIL=
